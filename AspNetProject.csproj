<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
	<PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
	<Compile Remove="AspNetProject.Tests\**" />
	<EmbeddedResource Remove="AspNetProject.Tests\**" />
	<None Remove="AspNetProject.Tests\**" />

	<Compile Remove="AspNetProject.IntegrationTests\**" />
	<EmbeddedResource Remove="AspNetProject.IntegrationTests\**" />
	<None Remove="AspNetProject.IntegrationTests\**" />

	<Compile Remove="Domain\**" />
	<EmbeddedResource Remove="Domain\**" />
	<None Remove="Domain\**" />

	<Compile Remove="Application\**" />
	<EmbeddedResource Remove="Application\**" />
	<None Remove="Application\**" />

	<Compile Remove="Infrastructure\**" />
	<EmbeddedResource Remove="Infrastructure\**" />
	<None Remove="Infrastructure\**" />

  </ItemGroup>

	<ItemGroup>
		<Content Remove="AspNetProject.Tests\**" />
		<Content Remove="AspNetProject.IntegrationTests\**" />
		<Compile Remove="bin\**" />
		<Compile Remove="obj\**" />
		<None Remove="bin\**" />
		<None Remove="obj\**" />
		<Content Remove="bin\**" />
		<Content Remove="obj\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="Domain\AspNetProject.Domain.csproj" />
		<ProjectReference Include="Application\AspNetProject.Application.csproj" />
		<ProjectReference Include="Infrastructure\AspNetProject.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="AspNetProject.Tests" />
		<InternalsVisibleTo Include="AspNetProject.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Presentation\appsettings.json">
			<Link>appsettings.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Update="Presentation\appsettings.Development.json">
			<Link>appsettings.Development.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
