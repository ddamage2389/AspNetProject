{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5435;Database=bookings;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Secret": "development-only-shared-jwt-secret-change-before-deployment",
    "Issuer": "AspNetProject.Users",
    "Audience": "AspNetProject",
    "ExpiryMinutes": 60
  },
  "Observability": {
    "ServiceName": "bookings-service"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317",
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "BookingSettings": {
    "MaxActiveBookingsPerUser": 5
  }
}
